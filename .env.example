# Vaani AI settings. Copy to .env and edit. Every VAANI_* default keeps today's behaviour.
# No real secrets belong in this file: generate them with `python -m assistant.auth init-env`.

# --- Local model (Ollama) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=2h
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=768
# OLLAMA_HOST=http://localhost:11434

# --- Existing behaviour ---
# code (default): the Confirm click runs the write in code. model: ask the model (comparison only).
# CONFIRM_MODE=code
# Extra guest / recipient domains allowed besides saved contacts and typed addresses (comma list).
# ALLOWED_ATTENDEE_DOMAINS=

# --- Sign-in ---
# single (default): no sign-in; token.json and data/memory.json, exactly as before.
# google: "Sign in with Google" on /login, one Vaani account per Google user (data/vaani.db,
#         data/users/<id>/memory.json). Open the app on http://127.0.0.1:<port>/ (loopback only).
VAANI_AUTH=single
# Comma list of Google emails allowed to sign in; empty = any Google account the OAuth app lets in
# (a Testing-mode consent screen still limits this to its test users).
VAANI_ALLOWED_EMAILS=
# Fernet key that encrypts stored Google refresh tokens. Changing it means everyone signs in again.
VAANI_TOKEN_KEY=
# Signs the vaani_session cookie. Unset: a random per-process secret (sign-ins end on restart).
VAANI_SESSION_SECRET=

# --- Autonomy ---
# 1: cards follow each workflow's autonomy level (suggest / one tap / auto). 0: every card waits for a click.
VAANI_AUTONOMY=0
# Workflows that may ever run at "auto" (comma list).
VAANI_AUTO_ALLOWED=triage
# 1: offer to raise a workflow's level after N clean confirmations in a row.
VAANI_PROMOTION=0
VAANI_PROMOTION_N=5

# --- Brief and follow-ups ---
# 1: a new chat opens with the inbox brief.
VAANI_BRIEF_ON_OPEN=0
# Minutes a built brief is reused before Gmail is read again.
VAANI_BRIEF_TTL_MIN=10
# How many days of mail the brief covers.
VAANI_BRIEF_DAYS=3
# 1: show "waiting on a reply" follow-ups for your own sent mail.
VAANI_FOLLOWUPS=0
# Days without a reply before a sent email counts as a follow-up.
VAANI_FOLLOWUP_DAYS=3
# 1: let the model write nudge text; 0: a fixed template.
VAANI_NUDGE_MODEL=0

# --- Look ---
# classic | ledger
VAANI_THEME=classic

# --- Voice (everything stays on this Mac) ---
# 1 (default): mic button and spoken replies. 0: voice is off (/voice/* answer 503).
VAANI_VOICE=1
# faster-whisper model, loaded on the CPU from the local Hugging Face cache only (never downloaded
# by the server). Fetch it once: python -m assistant.voice fetch. After that, HF_HUB_OFFLINE=1
# keeps the Hugging Face library offline.
VAANI_STT_MODEL=small.en
# HF_HUB_OFFLINE=1
# VAANI_STT_COMPUTE=int8
# CPU threads for speech-to-text (default: 8, or fewer on a smaller machine).
# VAANI_STT_THREADS=8
# macOS `say` voice (see `say -v '?'`) and speaking rate in words per minute.
VAANI_TTS_VOICE=Samantha
VAANI_TTS_RATE=185

# --- Voice mode (Jarvis HUD; Vaani opens in it) ---
# A spoken approval counts only at or above this speech-model confidence (0..1).
VAANI_VOICE_CONF_MIN=0.60
# User turns of transcript the model sees in voice mode (shorter = faster answers).
# VAANI_VOICE_CTX_TURNS=3
# 1: refuse every real send (saving drafts still works). For test and demo servers.
VAANI_BLOCK_SEND=0
